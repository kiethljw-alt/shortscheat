# ShortsCheat
OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 토스페이먼츠 — https://developers.tosspayments.com/my/api-keys 에서 발급
# (테스트 클라이언트 키는 토스 개발자센터 문서에 공개돼 있어 바로 써봐도 됨)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Supabase 프로젝트 설정 > API > service_role 키.
# RLS를 우회하므로 절대 클라이언트에 노출하지 말 것. 구독 갱신(cron) 등 서버 전용 작업에만 사용.
SUPABASE_SERVICE_ROLE_KEY=

# /api/subscriptions/renew를 호출할 때 Authorization: Bearer <값> 헤더로 검증하는 임의의 비밀값.
# 외부 크론(Supabase pg_cron, Vercel Cron 등)에 동일한 값을 설정해야 함. openssl rand -hex 32 등으로 생성.
CRON_SECRET=

# 트렌드 토픽 — 둘 다 없으면 "지금 뜨는 주제" 섹션이 그냥 숨겨짐(선택 사항).
# 유튜브 인기 급상승: https://console.cloud.google.com 에서 "YouTube Data API v3" 활성화 후 API 키 발급.
YOUTUBE_API_KEY=
# 네이버 검색어트렌드(2026-06 "NAVER API HUB"로 이관됨, 구 개발자센터 데이터랩 아님):
# https://www.ncloud.com 회원가입 → 콘솔 > Application Services > NAVER API HUB 이용 신청
# → Application 등록 시 "검색어트렌드" API 선택하면 발급됨.
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# Sentry 에러 모니터링 — https://sentry.io 프로젝트 생성 시 발급.
# 비워두면 Sentry가 아예 초기화되지 않고 앱은 평소처럼 동작함(선택 사항).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# 아래 3개는 프로덕션 빌드에서 소스맵을 Sentry에 업로드하고 싶을 때만 필요 (선택).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
