# ShortsCheat
OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 토스페이먼츠 — https://developers.tosspayments.com/my/api-keys 에서 발급
# (테스트 클라이언트 키는 토스 개발자센터 문서에 공개돼 있어 바로 써봐도 됨)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Supabase 프로젝트 설정 > API > service_role 키.
# RLS를 우회하므로 절대 클라이언트에 노출하지 말 것. 구독 갱신(cron) 등 서버 전용 작업에만 사용.
SUPABASE_SERVICE_ROLE_KEY=

# /api/subscriptions/renew를 호출할 때 Authorization: Bearer <값> 헤더로 검증하는 임의의 비밀값.
# 외부 크론(Supabase pg_cron, Vercel Cron 등)에 동일한 값을 설정해야 함. openssl rand -hex 32 등으로 생성.
CRON_SECRET=

# Cursor API 키 — 설정 시 에이전트가 자동으로 코드까지 생성합니다.
# https://cursor.com/dashboard 에서 발급
CURSOR_API_KEY=

# 에이전트 모델 (기본: composer-2.5)
CURSOR_AGENT_MODEL=composer-2.5

# 생성된 프로젝트 저장 경로 (기본: ./generated)
# GENERATED_PROJECTS_DIR=/Users/you/Projects/clients
